# Server-only configuration. Never expose these values through NEXT_PUBLIC_*.
# Tenant base URL only; an existing /webapp/api/v1 or /v2 suffix is normalized.
WECLAPP_BASE_URL=https://example.weclapp.com
WECLAPP_API_TOKEN=replace-with-a-local-development-token

# Kleinanzeigen integration. On hold until an approved connection is confirmed.
# Use "mock" only to exercise publishing and pausing in development.
KLEINANZEIGEN_MODE=disabled
# Optional persistent path outside a release directory in production:
# KLEINANZEIGEN_DATA_DIR=/var/lib/palmenheld-hub/kleinanzeigen

# Shopware 6 Admin API. Create a dedicated integration in Shopware and keep
# these values server-side. Grant only the Admin API permissions needed for the
# features you enable (product/media writes and order reads); use a separate
# integration and rotate its secret regularly.
SHOPWARE_BASE_URL=https://shop.example.com
SHOPWARE_CLIENT_ID=replace-with-the-integration-access-key
SHOPWARE_CLIENT_SECRET=replace-with-the-integration-secret-key

# Product publishing. Runtime drafts and mappings are stored here.
# Mount this directory persistently when the container itself is ephemeral.
# SHOPWARE_DATA_DIR=/workspace/.data/shopware

# Comma-separated extra hosts from which Weclapp product images may be loaded.
# The WECLAPP_BASE_URL host is trusted automatically.
# WECLAPP_IMAGE_HOSTS=cdn.example-weclapp.com

# Server-side research with OpenAI Responses API and web search.
OPENAI_API_KEY=replace-with-a-project-api-key
OPENAI_RESEARCH_MODEL=gpt-5.2
# Maximale Dauer eines einzelnen KI-Aufrufs (gründliche Webrecherche kann mehrere Minuten dauern).
OPENAI_REQUEST_TIMEOUT_MS=300000
# Fachrecherchen desselben Artikels werden so viele Tage wiederverwendet.
OPENAI_RESEARCH_CACHE_DAYS=30
# Optional: separate model for the final eBay sales copy.
# OPENAI_EBAY_COPY_MODEL=gpt-5.2

# Blog manager. Use a long random value; the server scheduler sends it only
# through a private localhost request. Jobs are persisted below .data by default.
BLOG_CRON_SECRET=replace-with-a-long-random-secret
# BLOG_DATA_DIR=/workspace/.data/blog

# eBay Sell APIs. Sandbox and Production have separate keysets and OAuth grants.
# A seller-authorized OAuth refresh token is required; an App ID alone is not enough.
EBAY_ENVIRONMENT=sandbox
EBAY_SANDBOX_CLIENT_ID=replace-with-sandbox-app-id
EBAY_SANDBOX_CLIENT_SECRET=replace-with-sandbox-cert-id
EBAY_SANDBOX_RUNAME=replace-with-sandbox-redirect-url-name
# Optional manual fallback; normally created by "Mit eBay verbinden":
# EBAY_SANDBOX_REFRESH_TOKEN=replace-with-sandbox-seller-refresh-token

EBAY_PRODUCTION_CLIENT_ID=replace-with-production-app-id
EBAY_PRODUCTION_CLIENT_SECRET=replace-with-production-cert-id
EBAY_PRODUCTION_RUNAME=replace-with-production-redirect-url-name
# Optional manual fallback; normally created by "Mit eBay verbinden":
# EBAY_PRODUCTION_REFRESH_TOKEN=replace-with-production-seller-refresh-token
# Production stays read-only until connection, policies and the first draft were checked.
EBAY_PRODUCTION_WRITES_ENABLED=false

EBAY_OAUTH_CALLBACK_URL=https://your-hub-domain.example/api/channels/ebay/oauth/callback

EBAY_PUBLISH_KEY=choose-a-long-private-confirmation-code
WECLAPP_EBAY_CURRENCY_ID=
EBAY_MARKETPLACE_ID=EBAY_DE
EBAY_CURRENCY=EUR
# Optional: defaults can also be selected in the Hub after connecting.
# EBAY_MERCHANT_LOCATION_KEY=palmenheld-warehouse
# EBAY_FULFILLMENT_POLICY_ID=...
# EBAY_PAYMENT_POLICY_ID=...
# EBAY_RETURN_POLICY_ID=...
# EBAY_DATA_DIR=/workspace/.data/ebay
